<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.jamesjarvis.content-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/jj-agent-bash</string>
        <string>/Users/jamesjarvis/development/jamesjarvis.io/scripts/sync-icloud.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jamesjarvis/Library/Logs/content-sync.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jamesjarvis/Library/Logs/content-sync.log</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
