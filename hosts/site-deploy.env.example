CF_PAGES_PROJECT=jamesjarvis-io
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

NTFY_TOPIC=

# B2_ACCOUNT_ID is the keyID of the application key, not the master account ID.
RESTIC_REPOSITORY=b2:BUCKET-NAME:jamesjarvis.io-content
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Either RESTIC_PASSWORD, or preferably read it from the macOS Keychain:
# RESTIC_PASSWORD_COMMAND=security find-generic-password -a jamesjarvis -s restic-jamesjarvis-io -w
RESTIC_PASSWORD=
