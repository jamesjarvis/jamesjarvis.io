[Unit]
Description=Back up jamesjarvis.io content to Backblaze B2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jamesjarvis
WorkingDirectory=/srv/site/repo
Environment=PATH=/home/jamesjarvis/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/site-deploy.env
ExecStart=/srv/site/repo/scripts/backup.sh
TimeoutStartSec=6h
Nice=15
