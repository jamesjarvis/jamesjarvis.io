[Unit]
Description=Build and deploy jamesjarvis.io
After=network-online.target syncthing@pi.service
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/srv/site/repo
Environment=PATH=/home/pi/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/site-deploy.env
ExecStart=/srv/site/repo/scripts/build-deploy.sh --pull
TimeoutStartSec=4h
Nice=10
